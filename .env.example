# Brand New Day — Environment Variables
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit it.

# ============================================================
# Required
# ============================================================

# JSearch API key (RapidAPI). Sign up at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 200 requests/month. Paid tiers available for higher throughput.
RAPIDAPI_KEY=your_rapidapi_key_here

# Runtime root. All data, config, and output paths resolve from this directory.
# Must exist and be writable before running `/brand-new-day init`.
BND_HOME=~/brand-new-day

# ============================================================
# Optional — Adzuna (disabled by default, enable in config.yml for Phase 2+)
# ============================================================

# Adzuna API credentials. Sign up at https://developer.adzuna.com/
# ADZUNA_APP_ID=your_adzuna_app_id_here
# ADZUNA_APP_KEY=your_adzuna_app_key_here
